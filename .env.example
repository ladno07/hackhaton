POSTGRES_PASSWORD=orencode-local-only
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=orencode_bot
PUBLIC_SITE_URL=http://localhost:8080

# Адрес сайта, доступный получателям публичных ссылок и QR
PUBLIC_BASE_URL=http://localhost:8080

# Разрешённые адреса интерфейса для входа, выхода и восстановления сессии
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080,http://127.0.0.1:5173
# true lets webhooks reach localhost and private networks (local receivers only)
WEBHOOK_ALLOW_PRIVATE=false
# Testing systems: Codeforces key/secret only for closed contests, Yandex Contest OAuth token
CODEFORCES_API_KEY=
CODEFORCES_API_SECRET=
YANDEX_CONTEST_TOKEN=
